<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>consulo</groupId>
        <artifactId>arch.bind.java</artifactId>
        <version>3-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>consulo.plugin</groupId>
    <artifactId>consulo.csharp.it</artifactId>
    <version>3-SNAPSHOT</version>
    <packaging>jar</packaging>

    <repositories>
        <repository>
            <id>consulo</id>
            <url>https://maven.consulo.dev/repository/snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
    </repositories>

    <!--
      Integration tests on top of consulo-it. Test sources only and no module-info.java: the headless harness
      resolves @ServiceImpl bindings through a classloader ServiceLoader, which skips providers in named modules.
      Nothing here ships - it is never packaged into the plugin.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-it</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.csharp</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- provided in consulo.csharp, so not inherited: dll detection and the netdll file system live here -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.dotnet</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- and its dll detector needs this, provided by the platform at runtime -->
        <dependency>
            <groupId>consulo.internal</groupId>
            <artifactId>format-ripper-jvm-file-type-detector</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- mono-dotnet and mono-csharp module extensions, which the test module is set up with -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.csharp-csharp.mono</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.dotnet.mono</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- consulo-it needs it at test scope only, so it is not inherited -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-hacking-java-base</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- the .NET debugger starts XDebuggerManager on project open (DotNetBreakpointListenerComponent) -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-execution-debug-impl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- and its breakpoint manager needs the http file system -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-virtual-file-system-http-impl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.6</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
